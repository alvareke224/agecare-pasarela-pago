// =====================================================================
//  AgeCare · Consola de Administración — Modelo de datos lógico (DBML)
//  Esquema PostgreSQL: admin        Versión 1 · Wellq Co · septiembre 2026
//  Importable en dbdiagram.io / dbdocs. Fuente canónica del modelo;
//  el DDL físico (agecare_admin_ddl.sql) deriva de este archivo.
//
//  Convenciones
//   · PK uuid (gen_random_uuid) salvo tablas de dominio (código natural)
//     y agregados (clave compuesta tenant + tiempo + dimensión).
//   · Toda tabla operativa o agregada lleva tenant_id (multi-tenant, RLS).
//   · Referencias a la BD de la app (app.users, app.patients, app.caregivers…)
//     son LÓGICAS: uuid sin FOREIGN KEY, marcadas «ref lógica → app.x».
//   · Las máquinas de estado se modelan como Enum (CHECK en el DDL);
//     los catálogos con nombre visible son tablas de dominio.
//   · Las 9 entidades mutables tienen una tabla *_history (no dibujada:
//     misma estructura + history_id, op, changed_at, changed_by).
// =====================================================================

Project agecare_admin {
  database_type: 'PostgreSQL'
  Note: 'Base de datos de la Consola de Administración de AgeCare. Esquema admin, PostgreSQL 16 (Azure Database for PostgreSQL Flexible Server).'
}

// ---------------------------------------------------------------------
// Enumeraciones (CHECK constraints en el DDL)
// ---------------------------------------------------------------------
Enum admin.component_status {
  operational
  degraded
  outage
}
Enum admin.incident_status {
  investigating
  observing
  resolved
  completed
}
Enum admin.ticket_status {
  open
  in_progress
  waiting_user
  resolved
  closed
}
Enum admin.ticket_priority {
  low
  medium
  high
  critical
}
Enum admin.ticket_channel {
  app
  email
  phone
  console
}
Enum admin.reply_author_type {
  admin
  user
  system
}
Enum admin.content_type {
  joke
  news
}
Enum admin.publication_status {
  draft
  published
  archived
}
Enum admin.tts_status {
  pending
  ready
  failed
}
Enum admin.caregiver_status {
  pending
  approved
  suspended
}
Enum admin.moderation_item_type {
  review
  caregiver_profile
  photo
  chat_message
}
Enum admin.moderation_status {
  pending
  approved
  rejected
}
Enum admin.reject_reason {
  offensive
  spam
  privacy
  off_topic
  other
}
Enum admin.legal_doc_type {
  terms
  privacy
}
Enum admin.legal_version_status {
  draft
  published
  superseded
}
Enum admin.store {
  ios
  android
}
Enum admin.latency_window {
  "1h"
  "24h"
  "7d"
}
Enum admin.job_status {
  running
  succeeded
  failed
}
Enum admin.access_level {
  read
  write
}

// ---------------------------------------------------------------------
// 0 · Tenants y catálogos globales (sin tenant_id)
// ---------------------------------------------------------------------
Table admin.tenants {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(20) [unique, not null, note: 'Identificador corto, p. ej. cl-prod']
  name varchar(120) [not null]
  country_code char(2) [not null, note: 'ISO 3166-1 alfa-2']
  currency_code char(3) [not null, note: 'ISO 4217; CLP en Chile. Todos los importes del tenant se guardan en esta moneda']
  timezone varchar(40) [not null, note: 'Zona horaria de negocio de las métricas, p. ej. America/Santiago']
  region varchar(60) [note: 'Región cloud mostrada en el banner de estado (Azure Chile Central)']
  environment varchar(20) [not null, default: 'production']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  Note: 'Despliegue/mercado administrado. Cada fila aísla sus datos por RLS (tenant_id).'
}

Table admin.tenant_counters {
  tenant_id uuid [not null]
  counter_name varchar(40) [not null, note: 'p. ej. ticket_number']
  next_value bigint [not null, default: 1]
  indexes {
    (tenant_id, counter_name) [pk]
  }
  Note: 'Correlativos por tenant (número visible de ticket «#1482»). Se incrementa con SELECT … FOR UPDATE dentro del trigger.'
}

Table admin.admin_roles {
  code varchar(20) [pk, note: 'admin | analyst | support | editor | moderator']
  name varchar(60) [not null, note: 'Nombre visible en español']
  description varchar(300)
  requires_mfa_default boolean [not null, default: false]
  sort_order smallint [not null, default: 0]
  Note: 'Roles internos del staff (spec 2.3).'
}

Table admin.admin_role_permissions {
  role_code varchar(20) [not null]
  module varchar(30) [not null, note: 'metrics | ops | support | content | marketplace | moderation | settings | legal | staff | audit']
  access admin.access_level [not null]
  indexes {
    (role_code, module) [pk]
  }
  Note: 'Matriz de permisos por módulo (spec 2.3). read = L, write = E; sin fila = sin acceso.'
}

Table admin.app_roles {
  code varchar(12) [pk, note: 'family | caregiver | elder | doctor']
  name varchar(60) [not null]
  sort_order smallint [not null, default: 0]
  Note: 'Perfiles de usuario final de la app (AppRole). Orden fijo de columnas en la matriz de adopción.'
}

Table admin.plans {
  code varchar(12) [pk, note: 'free | gold | platinum | provider']
  name varchar(60) [not null, note: 'Gratuito, Dorado, Platino, Proveedor']
  billing_unit varchar(12) [not null, note: 'user | family | provider | none — unidad facturable que cuenta el campo users del snapshot']
  is_paid boolean [not null]
  sort_order smallint [not null, default: 0]
  Note: 'Catálogo de planes. Los precios vigentes viven en system_settings (plan_prices) y se congelan en metrics_plan_snapshot.'
}

Table admin.components {
  key varchar(30) [pk, note: 'api_core | database | auth | push | alert_engine | wearable_ingest | ai_assistant | storage | music_sync']
  name varchar(80) [not null]
  is_async boolean [not null, default: false, note: 'push y ai_assistant miden latencia extremo a extremo, no HTTP']
  latency_note varchar(200) [note: 'Aclaración mostrada en la tarjeta (campo note)']
  sort_order smallint [not null, default: 0]
  Note: 'Componentes monitorizados (ComponentKey). Umbrales por componente en system_settings (ops_thresholds.*).'
}

Table admin.critical_processes {
  key varchar(40) [pk, note: 'fall_alert | sos | missed_medication | ai_query | music_sync']
  name varchar(120) [not null]
  chain varchar(300) [not null, note: 'Cadena legible: Wearable → ingesta → motor de alertas → push familiar']
  sort_order smallint [not null, default: 0]
  Note: 'Procesos críticos de negocio medidos extremo a extremo (spec 5.3).'
}

Table admin.ticket_categories {
  code varchar(20) [pk, note: 'account_access | wearable_sync | alerts_push | billing_plans | medications | other']
  name varchar(80) [not null]
  sort_order smallint [not null, default: 0]
}

Table admin.features {
  key varchar(50) [pk]
  name varchar(120) [not null]
  expected_low boolean [not null, default: false, note: 'true en funciones de emergencia (SOS): uso bajo correcto']
  note varchar(300) [note: 'Contexto para el panel de alertas de adopción']
  sort_order smallint [not null, default: 0]
  Note: 'Catálogo de funcionalidades instrumentadas. Se administra por seed/migración, no por API (spec 7).'
}

Table admin.feature_roles {
  feature_key varchar(50) [not null]
  app_role_code varchar(12) [not null]
  indexes {
    (feature_key, app_role_code) [pk]
  }
  Note: 'Perfiles a los que aplica cada función. Sin fila = celda gris (null) en la matriz de adopción.'
}

Table admin.setting_definitions {
  key varchar(80) [pk, note: 'p. ej. plan_prices, churn_definition, ops_thresholds.api_core, allowed_email_domains']
  description varchar(300) [not null]
  value_schema jsonb [not null, note: 'JSON Schema que valida el valor']
  default_value jsonb [not null]
  category varchar(40) [not null, note: 'plans | alerts | ops | medication | flags | texts | security']
  is_secret boolean [not null, default: false, note: 'Enmascarar en audit_log']
  Note: 'Catálogo de claves de configuración (definido por migración, sin DELETE por API — spec 12).'
}

Table admin.ticket_status_transitions {
  from_status admin.ticket_status [not null]
  to_status admin.ticket_status [not null]
  indexes {
    (from_status, to_status) [pk]
  }
  Note: 'Transiciones válidas de ticket (spec 8.4). El trigger de BD rechaza cualquier otra.'
}

Table admin.incident_status_transitions {
  from_status admin.incident_status [not null]
  to_status admin.incident_status [not null]
  is_maintenance boolean [not null]
  indexes {
    (from_status, to_status, is_maintenance) [pk]
  }
  Note: 'Transiciones válidas de incidente (spec 5.6): investigating → observing → resolved; mantenimientos → completed.'
}

// ---------------------------------------------------------------------
// 1 · Staff, sesiones y auditoría
// ---------------------------------------------------------------------
Table admin.admin_users {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  full_name varchar(120) [not null]
  email citext [not null, note: 'Correo corporativo; único por tenant; dominio validado contra allowed_email_domains']
  role_code varchar(20) [not null]
  password_hash varchar(255) [note: 'Argon2id. NULL = cuenta pendiente de activación']
  is_active boolean [not null, default: true]
  activated_at timestamptz [note: 'NULL hasta usar el enlace de activación']
  mfa_required boolean [not null, default: false]
  mfa_enabled boolean [not null, default: false]
  mfa_secret_enc bytea [note: 'Secreto TOTP cifrado en aplicación (KMS/Key Vault); nunca en claro']
  failed_attempts smallint [not null, default: 0]
  locked_until timestamptz [note: 'Bloqueo de 15 min tras 5 fallos en 10 min']
  last_login_at timestamptz
  created_by uuid [note: 'Admin que creó la cuenta']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, email) [unique]
    (tenant_id, role_code, is_active)
  }
  Note: 'Cuentas del personal de Wellq Co, separadas de los usuarios de la app. Historial en admin_users_history.'
}

Table admin.admin_invitations {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  admin_id uuid [not null]
  token_hash char(64) [unique, not null, note: 'SHA-256 del token del enlace de activación']
  expires_at timestamptz [not null, note: '24 h desde la creación']
  used_at timestamptz
  created_by uuid
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (admin_id)
  }
  Note: 'Enlaces de activación de un solo uso (spec 3.5). Permite reenviar invitaciones sin perder trazabilidad.'
}

Table admin.admin_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  admin_id uuid [not null]
  refresh_token_hash char(64) [unique, not null, note: 'SHA-256 del refresh token']
  family_id uuid [not null, note: 'Cadena de rotación: todas las rotaciones de un login comparten family_id']
  rotated_from uuid [note: 'Sesión anterior en la cadena']
  expires_at timestamptz [not null, note: '12 h']
  revoked_at timestamptz
  revoked_reason varchar(30) [note: 'logout | rotated | reuse_detected | admin_disabled | expired']
  ip inet
  user_agent varchar(300)
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (admin_id, revoked_at)
    (family_id)
    (expires_at)
  }
  Note: 'Refresh tokens rotatorios (spec 3.2). Reusar un token ya rotado revoca toda la familia.'
}

Table admin.admin_login_attempts {
  id bigint [pk, increment]
  tenant_id uuid [not null]
  email citext [not null]
  admin_id uuid [note: 'NULL si el correo no existe (el login no revela existencia)']
  succeeded boolean [not null]
  failure_code varchar(30) [note: 'INVALID_CREDENTIALS | OTP_REQUIRED | OTP_INVALID | ADMIN_DISABLED | ACCOUNT_LOCKED']
  ip inet
  user_agent varchar(300)
  attempted_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, email, attempted_at)
  }
  Note: 'Intentos de login persistidos para el bloqueo progresivo (spec 3.1). Retención 90 días.'
}

Table admin.audit_log {
  id uuid [not null, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  actor_id uuid [note: 'admin_users.id; NULL en acciones de sistema (jobs, monitor)']
  actor_name varchar(120) [note: 'Snapshot: el nombre puede cambiar después']
  actor_role varchar(20) [note: 'Snapshot del rol en el momento de la acción']
  action varchar(60) [not null, note: 'Tipificada: ticket.update, settings.update, auth.login_failed…']
  entity_type varchar(40)
  entity_id uuid
  before jsonb [note: 'Diff previo con campos sensibles enmascarados']
  after jsonb
  ip inet
  user_agent varchar(300)
  request_id uuid [note: 'Trazabilidad con error.request_id']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (id, created_at) [pk]
    (tenant_id, created_at)
    (tenant_id, actor_id, created_at)
    (tenant_id, entity_type, entity_id)
    (tenant_id, action, created_at)
  }
  Note: 'Registro inmutable (solo INSERT: sin GRANT UPDATE/DELETE + trigger). Particionada por mes (created_at), retención 24 meses.'
}

// ---------------------------------------------------------------------
// 2 · Métricas comerciales (agregados por jobs)
// ---------------------------------------------------------------------
Table admin.store_downloads_daily {
  tenant_id uuid [not null]
  day date [not null]
  store admin.store [not null]
  downloads integer [not null, default: 0]
  ingested_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, day, store) [pk]
  }
  Note: 'Ingesta diaria de App Store Connect y Google Play Console (spec 2.8 / 4.4).'
}

Table admin.metrics_daily_users {
  tenant_id uuid [not null]
  day date [not null, note: 'Día en la zona horaria del tenant']
  signups integer [not null, default: 0]
  cancellations integer [not null, default: 0, note: 'Bajas explícitas']
  churned_users integer [not null, default: 0, note: 'Bajas + inactivos > N días según churn_definition']
  downloads integer [not null, default: 0, note: 'Suma de store_downloads_daily']
  active_users_eod integer [not null, default: 0, note: 'MAU al cierre del día']
  paying_users_eod integer [not null, default: 0]
  mrr_amount bigint [not null, default: 0, note: 'MRR al cierre, en la moneda del tenant (CLP)']
  is_final boolean [not null, default: false, note: 'false mientras el día en curso se refresca cada hora']
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, day) [pk]
  }
  Note: 'Serie diaria base de Uso comercial (spec 4.1/4.2). Job diario 03:00 consolida el día anterior; job horario refresca el día en curso.'
}

Table admin.metrics_hourly_users {
  tenant_id uuid [not null]
  ts_hour timestamptz [not null, note: 'Inicio de la hora (UTC)']
  signups integer [not null, default: 0]
  cancellations integer [not null, default: 0]
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, ts_hour) [pk]
  }
  Note: 'Buckets por hora para el periodo today (spec 4.2). Retención 7 días.'
}

Table admin.metrics_plan_snapshot {
  tenant_id uuid [not null]
  as_of date [not null]
  plan_code varchar(12) [not null]
  users integer [not null, note: 'Unidad facturable del plan (usuarios, familias o proveedores)']
  price_amount integer [note: 'Precio congelado en el snapshot; NULL en free']
  mrr_amount bigint [not null, default: 0]
  monthly_churn numeric(6,5) [not null, default: 0, note: '0–1']
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, as_of, plan_code) [pk]
  }
  Note: 'Mezcla de planes (spec 4.3). Snapshot diario; el precio se congela para no reescribir la historia.'
}

Table admin.metrics_funnel_snapshot {
  tenant_id uuid [not null]
  as_of date [not null]
  downloads_total bigint [not null]
  accounts_total bigint [not null]
  active_30d integer [not null]
  paying integer [not null]
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, as_of) [pk]
  }
  Note: 'Embudo acumulado a la fecha (spec 4.4): descargas → cuentas → activos 30 d → de pago.'
}

// ---------------------------------------------------------------------
// 3 · Perfiles y adopción de funcionalidades
// ---------------------------------------------------------------------
Table admin.role_activity_window {
  tenant_id uuid [not null]
  days_window smallint [not null, note: 'Ventanas precalculadas: 7, 14, 30, 60, 90']
  app_role_code varchar(12) [not null]
  active_users integer [not null]
  growth_8w numeric(7,4) [not null, default: 0, note: 'Variación relativa de activos en 8 semanas']
  sessions_per_week numeric(7,2) [not null, default: 0]
  avg_session_seconds integer [not null, default: 0]
  retention_30d numeric(6,5) [not null, default: 0]
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, days_window, app_role_code) [pk]
  }
  Note: 'Intensidad de uso por perfil (spec 6.1). Un usuario con dos roles cuenta en ambos.'
}

Table admin.role_weekly_active {
  tenant_id uuid [not null]
  week_start date [not null, note: 'Lunes de la semana ISO']
  app_role_code varchar(12) [not null]
  active_users integer [not null]
  is_partial boolean [not null, default: false, note: 'true en la semana en curso']
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, week_start, app_role_code) [pk]
  }
  Note: 'Usuarios activos semanales por perfil (spec 6.2).'
}

Table admin.feature_usage_events {
  event_id uuid [not null, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  occurred_at timestamptz [not null]
  user_id uuid [not null, note: 'ref lógica → app.users.id']
  app_role_code varchar(12) [not null, note: 'Rol con el que actuaba el usuario']
  feature_key varchar(50) [not null]
  session_id uuid [note: 'ref lógica → app.sessions.id']
  platform varchar(10) [note: 'ios | android | web']
  app_version varchar(20)
  indexes {
    (event_id, occurred_at) [pk]
    (tenant_id, occurred_at, feature_key)
    (tenant_id, user_id, occurred_at)
  }
  Note: 'Eventos crudos emitidos por la app (spec 7). Particionada por mes (occurred_at), retención 13 meses. Solo INSERT desde la ingesta.'
}

Table admin.feature_usage_daily {
  tenant_id uuid [not null]
  day date [not null]
  feature_key varchar(50) [not null]
  app_role_code varchar(12) [not null]
  unique_users integer [not null]
  events integer [not null]
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, day, feature_key, app_role_code) [pk]
  }
  Note: 'Usuarios únicos por función, rol y día (spec 2.8).'
}

Table admin.feature_usage_window {
  tenant_id uuid [not null]
  days_window smallint [not null, note: '7 | 30 | 90']
  feature_key varchar(50) [not null]
  app_role_code varchar(12) [not null]
  users integer [not null, note: 'Usuarios únicos del rol que usaron la función en la ventana']
  role_active_users integer [not null, note: 'Denominador: activos del rol en la misma ventana']
  adoption numeric(6,5) [note: 'Columna generada: users / role_active_users']
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, days_window, feature_key, app_role_code) [pk]
  }
  Note: 'Matriz de adopción (spec 7.1–7.3). Solo existen filas para pares (función, rol) de feature_roles; null en la API = sin fila.'
}

// ---------------------------------------------------------------------
// 4 · Estado operativo
// ---------------------------------------------------------------------
Table admin.ops_component_checks {
  tenant_id uuid [not null]
  component_key varchar(30) [not null]
  checked_at timestamptz [not null]
  ok boolean [not null]
  latency_ms integer
  error_rate numeric(6,5) [note: 'Tasa de error observada en el ciclo (0–1)']
  detail varchar(300)
  indexes {
    (tenant_id, component_key, checked_at) [pk]
  }
  Note: 'Health checks cada 60 s (spec 2.8). Particionada por día (checked_at), retención 90 días. Fuente del uptime_30d.'
}

Table admin.ops_request_stats {
  tenant_id uuid [not null]
  component_key varchar(30) [not null]
  minute timestamptz [not null, note: 'Inicio del minuto']
  p50_ms integer [not null]
  p95_ms integer [not null]
  p99_ms integer
  sample_count integer [not null]
  error_count integer [not null, default: 0]
  indexes {
    (tenant_id, component_key, minute) [pk]
  }
  Note: 'Percentiles de latencia por componente y minuto desde OpenTelemetry (spec 2.8). Particionada por día, retención 90 días.'
}

Table admin.ops_component_state {
  tenant_id uuid [not null]
  component_key varchar(30) [not null]
  status admin.component_status [not null]
  status_since timestamptz [not null]
  consecutive_failures smallint [not null, default: 0, note: '3 seguidos → outage']
  consecutive_breaches smallint [not null, default: 0, note: '3 seguidos sobre umbral → degraded']
  uptime_30d numeric(6,5) [not null, default: 1]
  latency_p50_ms integer
  latency_p95_ms integer
  note varchar(200)
  checked_at timestamptz [not null]
  indexes {
    (tenant_id, component_key) [pk]
  }
  Note: 'Última foto de cada componente, mantenida por el monitor (spec 5.1).'
}

Table admin.ops_component_status_history {
  id bigint [pk, increment]
  tenant_id uuid [not null]
  component_key varchar(30) [not null]
  from_status admin.component_status
  to_status admin.component_status [not null]
  changed_at timestamptz [not null, default: `now()`]
  reason varchar(300)
  incident_id uuid [note: 'Incidente abierto automáticamente al pasar a outage']
  indexes {
    (tenant_id, component_key, changed_at)
  }
  Note: 'Transiciones de estado de componentes: base del uptime histórico y de la apertura automática de incidentes.'
}

Table admin.ops_latency_window {
  tenant_id uuid [not null]
  window admin.latency_window [not null]
  component_key varchar(30) [not null]
  p50_ms integer [not null]
  p95_ms integer [not null]
  sample_count integer [not null]
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, window, component_key) [pk]
  }
  Note: 'Percentiles agregados por ventana 1h/24h/7d a partir de ops_request_stats (spec 5.2). Refresco cada minuto.'
}

Table admin.ops_critical_process_runs {
  tenant_id uuid [not null]
  process_key varchar(40) [not null]
  started_at timestamptz [not null]
  duration_seconds numeric(9,3) [not null]
  succeeded boolean [not null]
  is_synthetic boolean [not null, default: false]
  trace_id varchar(64)
  indexes {
    (tenant_id, process_key, started_at)
  }
  Note: 'Ejecuciones reales y sintéticas de cada proceso crítico (spec 5.3). Particionada por día, retención 90 días.'
}

Table admin.ops_critical_process_state {
  tenant_id uuid [not null]
  process_key varchar(40) [not null]
  p95_seconds numeric(9,3) [not null]
  success_24h numeric(6,5) [not null]
  status admin.component_status [not null]
  based_on_synthetic boolean [not null, default: false, note: 'true si no hubo ejecuciones reales en 24 h']
  last_run_at timestamptz
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, process_key) [pk]
  }
}

Table admin.ops_incidents {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  title varchar(160) [not null]
  component_key varchar(30) [note: 'NULL en incidentes transversales']
  severity admin.component_status [not null, note: 'degraded | outage (nunca operational)']
  status admin.incident_status [not null]
  is_maintenance boolean [not null, default: false]
  auto_created boolean [not null, default: false, note: 'Abierto por el monitor']
  description text [not null, note: '≤ 4000']
  resolution text [note: '≤ 2000; obligatoria en resolved/completed']
  started_at timestamptz [not null]
  resolved_at timestamptz
  created_by uuid [note: 'NULL si auto_created']
  updated_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, started_at)
    (tenant_id, status)
    (tenant_id, component_key)
  }
  Note: 'Incidentes y mantenimientos (spec 5.4–5.6). Historial en ops_incidents_history.'
}

// ---------------------------------------------------------------------
// 5 · Soporte
// ---------------------------------------------------------------------
Table admin.support_tickets {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  number bigint [not null, note: 'Correlativo visible por tenant, asignado por trigger desde tenant_counters']
  subject varchar(160) [not null]
  description text [not null, note: '≤ 8000']
  requester_user_id uuid [note: 'ref lógica → app.users.id; NULL si no se enlazó cuenta (confirm_unlinked)']
  requester_name varchar(120) [not null]
  requester_email citext [not null]
  requester_role_code varchar(12)
  requester_plan_code varchar(12) [note: 'Plan del solicitante al crear el ticket']
  requester_context jsonb [note: 'Snapshot: patients[], devices[] (spec 8.2). Se refresca al abrir el detalle']
  category_code varchar(20) [not null]
  priority admin.ticket_priority [not null, default: 'medium']
  status admin.ticket_status [not null, default: 'open']
  channel admin.ticket_channel [not null, default: 'app']
  assigned_to uuid
  first_response_at timestamptz [note: 'Fijado por trigger con la primera respuesta no interna de un admin']
  resolved_at timestamptz
  closed_at timestamptz [note: 'Cierre automático 7 días después de resolved']
  reopen_count smallint [not null, default: 0]
  created_by uuid [note: 'Admin que creó el ticket manual; NULL si viene de app/correo']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, number) [unique]
    (tenant_id, status, created_at)
    (tenant_id, assigned_to)
    (tenant_id, category_code, created_at)
    (tenant_id, requester_user_id)
    (tenant_id, created_at)
  }
  Note: 'Cola de soporte (spec 8). Búsqueda q por número, asunto y correo con índice trigram. Historial en support_tickets_history.'
}

Table admin.support_ticket_replies {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  ticket_id uuid [not null]
  author_type admin.reply_author_type [not null]
  author_admin_id uuid [note: 'Cuando author_type = admin']
  author_user_id uuid [note: 'ref lógica → app.users.id cuando author_type = user']
  author_name varchar(120) [not null]
  body text [not null, note: '1–8000']
  is_internal boolean [not null, default: false, note: 'Nota interna invisible para el usuario']
  created_at timestamptz [not null, default: `now()`]
  indexes {
    (ticket_id, created_at)
  }
  Note: 'Conversación del ticket (spec 8.5/8.6). Inmutable: sin UPDATE.'
}

Table admin.support_csat_surveys {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  ticket_id uuid [unique, not null]
  sent_at timestamptz [not null, default: `now()`]
  responded_at timestamptz
  score smallint [note: '1–5']
  comment text
  indexes {
    (tenant_id, responded_at)
  }
  Note: 'Encuesta post-resolución (spec 8.2/6.3). Se envía al pasar a resolved.'
}

Table admin.support_metrics_daily {
  tenant_id uuid [not null]
  day date [not null]
  tickets_created integer [not null, default: 0]
  tickets_resolved integer [not null, default: 0]
  tickets_closed integer [not null, default: 0]
  first_response_seconds_avg integer
  resolution_seconds_avg integer
  csat_sum integer [not null, default: 0]
  csat_count integer [not null, default: 0]
  computed_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, day) [pk]
  }
  Note: 'Agregado diario de soporte (spec 2.8 / 6.3). Los contadores de estado en vivo se leen de support_tickets.'
}

// ---------------------------------------------------------------------
// 6 · Curación de contenido
// ---------------------------------------------------------------------
Table admin.content_items {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  type admin.content_type [not null]
  title varchar(160) [not null]
  body text [not null, note: '10–4000']
  tags "text[]" [not null, default: '{}', note: '≤ 10 etiquetas; índice GIN']
  status admin.publication_status [not null, default: 'draft']
  tts_status admin.tts_status [not null, default: 'pending', note: 'Audio TTS generado al crear/editar el cuerpo']
  tts_audio_url varchar(500)
  publish_at timestamptz [note: 'Publicación programada (futura)']
  published_at timestamptz
  archived_at timestamptz
  deleted_at timestamptz [note: 'Borrado lógico (spec 9.6)']
  created_by uuid [not null]
  updated_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, type, status)
    (tenant_id, publish_at)
  }
  Note: 'Chistes y noticias curados (spec 9). El feed de la app lee status = published AND deleted_at IS NULL. Historial en content_items_history.'
}

// ---------------------------------------------------------------------
// 7 · Marketplace
// ---------------------------------------------------------------------
Table admin.marketplace_caregivers {
  caregiver_id uuid [pk, note: 'ref lógica → app.caregivers.id (misma clave)']
  tenant_id uuid [not null]
  display_name varchar(120) [not null, note: 'Sincronizado desde la app']
  email citext [not null]
  zone varchar(80) [not null, note: 'Comuna o zona declarada']
  specialties "text[]" [not null, default: '{}']
  languages "text[]" [not null, default: '{}']
  certifications_count smallint [not null, default: 0]
  certifications_verified_count smallint [not null, default: 0, note: 'Aprobar exige ≥ 1']
  rating_avg numeric(3,2) [note: '1–5']
  reviews_count integer [not null, default: 0]
  status admin.caregiver_status [not null, default: 'pending']
  status_reason varchar(1000) [note: 'Obligatorio al suspender; se notifica a la cuidadora']
  internal_note text [note: '≤ 2000, no visible para la cuidadora']
  submitted_at timestamptz [not null]
  reviewed_by uuid
  reviewed_at timestamptz
  synced_at timestamptz [not null, default: `now()`, note: 'Última sincronización de los campos denormalizados']
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, status, submitted_at)
    (tenant_id, zone)
  }
  Note: 'Estado de publicación en la vitrina de cada perfil de cuidadora (spec 10.1/10.2). Historial en marketplace_caregivers_history.'
}

Table admin.marketplace_products {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  name varchar(160) [not null]
  category varchar(60) [not null, note: 'movilidad, baño, monitoreo…']
  vendor varchar(120) [not null]
  price_amount integer [note: 'Referencial, moneda del tenant; ≥ 0']
  external_url varchar(500) [not null, note: 'Debe ser https']
  image_url varchar(500)
  status admin.publication_status [not null, default: 'draft']
  published_at timestamptz
  archived_at timestamptz
  created_by uuid [not null]
  updated_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, status, category)
  }
  Note: 'Catálogo de artículos de apoyo sin transacciones en v1 (spec 10.3–10.5). Historial en marketplace_products_history.'
}

// ---------------------------------------------------------------------
// 8 · Moderación
// ---------------------------------------------------------------------
Table admin.moderation_items {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  item_type admin.moderation_item_type [not null]
  source_entity_id uuid [not null, note: 'ref lógica → app.reviews / app.photos / app.chat_messages / app.caregivers']
  content_snapshot jsonb [not null, note: 'Texto y rating de la reseña o referencia de almacenamiento; nunca el binario ni la URL firmada']
  author_user_id uuid [not null, note: 'ref lógica → app.users.id']
  author_name varchar(120) [not null]
  author_role_code varchar(12)
  reported_by_user_id uuid [note: 'NULL en moderación previa']
  reported_by_name varchar(120)
  report_reason varchar(300)
  is_safety_report boolean [not null, default: false, note: 'Los reportes de seguridad se ordenan primero']
  status admin.moderation_status [not null, default: 'pending']
  reject_reason_code admin.reject_reason [note: 'Obligatorio si rejected']
  decision_note varchar(1000) [note: 'Obligatoria si reject_reason_code = other']
  decided_by uuid
  decided_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, status, is_safety_report, created_at)
    (tenant_id, author_user_id, decided_at)
    (tenant_id, item_type, source_entity_id) [unique]
  }
  Note: 'Cola única de moderación (spec 11). Historial en moderation_items_history.'
}

Table admin.moderation_escalations {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  author_user_id uuid [not null, note: 'ref lógica → app.users.id']
  rejections_count smallint [not null]
  window_days smallint [not null, default: 90]
  triggered_at timestamptz [not null, default: `now()`]
  is_open boolean [not null, default: true]
  reviewed_by uuid
  reviewed_at timestamptz
  review_note text
  indexes {
    (tenant_id, is_open, triggered_at)
  }
  Note: 'Casos escalados al admin por el job de reglas: 3 rechazos por contenido ofensivo del mismo autor en 90 días (spec 11.3).'
}

// ---------------------------------------------------------------------
// 9 · Configuración y legales
// ---------------------------------------------------------------------
Table admin.system_settings {
  tenant_id uuid [not null]
  key varchar(80) [not null]
  value jsonb [not null, note: 'Validado contra setting_definitions.value_schema']
  version integer [not null, default: 1, note: 'Bloqueo optimista (spec 12.2)']
  change_note varchar(500)
  updated_by uuid
  updated_at timestamptz
  indexes {
    (tenant_id, key) [pk]
  }
  Note: 'Valor vigente de cada parámetro por tenant. Historial de versiones en system_settings_history.'
}

Table admin.legal_versions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  doc_type admin.legal_doc_type [not null]
  semver_major smallint [not null]
  semver_minor smallint [not null]
  semver varchar(10) [note: 'Columna generada: major.minor']
  content_md text [not null, note: '≥ 100 caracteres']
  changelog varchar(2000) [not null]
  effective_date date [not null]
  requires_reacceptance boolean [not null, note: 'true si el salto es de versión mayor']
  status admin.legal_version_status [not null, default: 'draft']
  published_by uuid
  published_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, doc_type, semver_major, semver_minor) [unique]
    (tenant_id, doc_type, status, effective_date)
  }
  Note: 'Términos y privacidad versionados (spec 13). Nunca se borra: app.legal_acceptances referencia legal_versions.id.'
}

// ---------------------------------------------------------------------
// 10 · Operación de jobs
// ---------------------------------------------------------------------
Table admin.job_runs {
  id bigint [pk, increment]
  tenant_id uuid [note: 'NULL en jobs globales (mantenimiento de particiones)']
  job_name varchar(60) [not null, note: 'metrics_daily, metrics_hourly, plan_snapshot, store_downloads, feature_usage_daily, support_metrics, ops_monitor, moderation_rules, partition_maintenance…']
  status admin.job_status [not null]
  started_at timestamptz [not null, default: `now()`]
  finished_at timestamptz
  watermark timestamptz [note: 'Hasta qué instante quedaron consolidados los datos']
  rows_affected integer
  error text
  indexes {
    (job_name, started_at)
    (tenant_id, job_name, status)
  }
  Note: 'Bitácora de jobs: frescura (computed_at), reintentos y alerta cuando un conector falla (spec 4.4).'
}

// ---------------------------------------------------------------------
// Relaciones
// ---------------------------------------------------------------------
// tenants
Ref: admin.tenant_counters.tenant_id > admin.tenants.id
Ref: admin.admin_users.tenant_id > admin.tenants.id
Ref: admin.admin_invitations.tenant_id > admin.tenants.id
Ref: admin.admin_sessions.tenant_id > admin.tenants.id
Ref: admin.admin_login_attempts.tenant_id > admin.tenants.id
Ref: admin.audit_log.tenant_id > admin.tenants.id
Ref: admin.store_downloads_daily.tenant_id > admin.tenants.id
Ref: admin.metrics_daily_users.tenant_id > admin.tenants.id
Ref: admin.metrics_hourly_users.tenant_id > admin.tenants.id
Ref: admin.metrics_plan_snapshot.tenant_id > admin.tenants.id
Ref: admin.metrics_funnel_snapshot.tenant_id > admin.tenants.id
Ref: admin.role_activity_window.tenant_id > admin.tenants.id
Ref: admin.role_weekly_active.tenant_id > admin.tenants.id
Ref: admin.feature_usage_events.tenant_id > admin.tenants.id
Ref: admin.feature_usage_daily.tenant_id > admin.tenants.id
Ref: admin.feature_usage_window.tenant_id > admin.tenants.id
Ref: admin.ops_component_checks.tenant_id > admin.tenants.id
Ref: admin.ops_request_stats.tenant_id > admin.tenants.id
Ref: admin.ops_component_state.tenant_id > admin.tenants.id
Ref: admin.ops_component_status_history.tenant_id > admin.tenants.id
Ref: admin.ops_latency_window.tenant_id > admin.tenants.id
Ref: admin.ops_critical_process_runs.tenant_id > admin.tenants.id
Ref: admin.ops_critical_process_state.tenant_id > admin.tenants.id
Ref: admin.ops_incidents.tenant_id > admin.tenants.id
Ref: admin.support_tickets.tenant_id > admin.tenants.id
Ref: admin.support_ticket_replies.tenant_id > admin.tenants.id
Ref: admin.support_csat_surveys.tenant_id > admin.tenants.id
Ref: admin.support_metrics_daily.tenant_id > admin.tenants.id
Ref: admin.content_items.tenant_id > admin.tenants.id
Ref: admin.marketplace_caregivers.tenant_id > admin.tenants.id
Ref: admin.marketplace_products.tenant_id > admin.tenants.id
Ref: admin.moderation_items.tenant_id > admin.tenants.id
Ref: admin.moderation_escalations.tenant_id > admin.tenants.id
Ref: admin.system_settings.tenant_id > admin.tenants.id
Ref: admin.legal_versions.tenant_id > admin.tenants.id
Ref: admin.job_runs.tenant_id > admin.tenants.id

// staff
Ref: admin.admin_role_permissions.role_code > admin.admin_roles.code
Ref: admin.admin_users.role_code > admin.admin_roles.code
Ref: admin.admin_users.created_by > admin.admin_users.id
Ref: admin.admin_invitations.admin_id > admin.admin_users.id
Ref: admin.admin_invitations.created_by > admin.admin_users.id
Ref: admin.admin_sessions.admin_id > admin.admin_users.id
Ref: admin.admin_sessions.rotated_from - admin.admin_sessions.id
Ref: admin.admin_login_attempts.admin_id > admin.admin_users.id
Ref: admin.audit_log.actor_id > admin.admin_users.id

// catálogos
Ref: admin.feature_roles.feature_key > admin.features.key
Ref: admin.feature_roles.app_role_code > admin.app_roles.code
Ref: admin.metrics_plan_snapshot.plan_code > admin.plans.code
Ref: admin.role_activity_window.app_role_code > admin.app_roles.code
Ref: admin.role_weekly_active.app_role_code > admin.app_roles.code
Ref: admin.feature_usage_events.feature_key > admin.features.key
Ref: admin.feature_usage_events.app_role_code > admin.app_roles.code
Ref: admin.feature_usage_daily.feature_key > admin.features.key
Ref: admin.feature_usage_daily.app_role_code > admin.app_roles.code
Ref: admin.feature_usage_window.feature_key > admin.features.key
Ref: admin.feature_usage_window.app_role_code > admin.app_roles.code

// ops
Ref: admin.ops_component_checks.component_key > admin.components.key
Ref: admin.ops_request_stats.component_key > admin.components.key
Ref: admin.ops_component_state.component_key > admin.components.key
Ref: admin.ops_component_status_history.component_key > admin.components.key
Ref: admin.ops_component_status_history.incident_id > admin.ops_incidents.id
Ref: admin.ops_latency_window.component_key > admin.components.key
Ref: admin.ops_critical_process_runs.process_key > admin.critical_processes.key
Ref: admin.ops_critical_process_state.process_key > admin.critical_processes.key
Ref: admin.ops_incidents.component_key > admin.components.key
Ref: admin.ops_incidents.created_by > admin.admin_users.id
Ref: admin.ops_incidents.updated_by > admin.admin_users.id

// soporte
Ref: admin.support_tickets.category_code > admin.ticket_categories.code
Ref: admin.support_tickets.requester_role_code > admin.app_roles.code
Ref: admin.support_tickets.requester_plan_code > admin.plans.code
Ref: admin.support_tickets.assigned_to > admin.admin_users.id
Ref: admin.support_tickets.created_by > admin.admin_users.id
Ref: admin.support_ticket_replies.ticket_id > admin.support_tickets.id
Ref: admin.support_ticket_replies.author_admin_id > admin.admin_users.id
Ref: admin.support_csat_surveys.ticket_id - admin.support_tickets.id

// contenido y marketplace
Ref: admin.content_items.created_by > admin.admin_users.id
Ref: admin.content_items.updated_by > admin.admin_users.id
Ref: admin.marketplace_caregivers.reviewed_by > admin.admin_users.id
Ref: admin.marketplace_products.created_by > admin.admin_users.id
Ref: admin.marketplace_products.updated_by > admin.admin_users.id

// moderación
Ref: admin.moderation_items.author_role_code > admin.app_roles.code
Ref: admin.moderation_items.decided_by > admin.admin_users.id
Ref: admin.moderation_escalations.reviewed_by > admin.admin_users.id

// configuración y legales
Ref: admin.system_settings.key > admin.setting_definitions.key
Ref: admin.system_settings.updated_by > admin.admin_users.id
Ref: admin.legal_versions.created_by > admin.admin_users.id
Ref: admin.legal_versions.published_by > admin.admin_users.id

// ---------------------------------------------------------------------
// Agrupación por módulo (para diagramas)
// ---------------------------------------------------------------------
TableGroup "0 Tenants y catálogos" {
  admin.tenants
  admin.tenant_counters
  admin.admin_roles
  admin.admin_role_permissions
  admin.app_roles
  admin.plans
  admin.components
  admin.critical_processes
  admin.ticket_categories
  admin.features
  admin.feature_roles
  admin.setting_definitions
  admin.ticket_status_transitions
  admin.incident_status_transitions
}
TableGroup "1 Staff y auditoría" {
  admin.admin_users
  admin.admin_invitations
  admin.admin_sessions
  admin.admin_login_attempts
  admin.audit_log
}
TableGroup "2 Métricas comerciales" {
  admin.store_downloads_daily
  admin.metrics_daily_users
  admin.metrics_hourly_users
  admin.metrics_plan_snapshot
  admin.metrics_funnel_snapshot
}
TableGroup "3 Perfiles y adopción" {
  admin.role_activity_window
  admin.role_weekly_active
  admin.feature_usage_events
  admin.feature_usage_daily
  admin.feature_usage_window
}
TableGroup "4 Estado operativo" {
  admin.ops_component_checks
  admin.ops_request_stats
  admin.ops_component_state
  admin.ops_component_status_history
  admin.ops_latency_window
  admin.ops_critical_process_runs
  admin.ops_critical_process_state
  admin.ops_incidents
}
TableGroup "5 Soporte" {
  admin.support_tickets
  admin.support_ticket_replies
  admin.support_csat_surveys
  admin.support_metrics_daily
}
TableGroup "6 Contenido y marketplace" {
  admin.content_items
  admin.marketplace_caregivers
  admin.marketplace_products
}
TableGroup "7 Moderación" {
  admin.moderation_items
  admin.moderation_escalations
}
TableGroup "8 Configuración y legales" {
  admin.system_settings
  admin.legal_versions
}
TableGroup "9 Jobs" {
  admin.job_runs
}

// =====================================================================
//  11 · Pasarela de pago y suscripciones (Transbank Oneclick Mall)
//  Añadido oct 2026. DDL físico: agecare_billing_ddl.sql (se aplica
//  después de agecare_admin_ddl.sql). Historial *_history en
//  billing_payment_methods, billing_subscriptions y billing_charges.
// =====================================================================
Enum admin.subscription_status {
  incomplete
  active
  past_due
  canceled
  expired
}
Enum admin.payment_method_status {
  pending
  active
  failed
  aborted
  removed
}
Enum admin.charge_status {
  pending
  authorized
  failed
  unknown
  refunded
  partially_refunded
}
Enum admin.charge_kind {
  initial
  renewal
  retry
  manual
}

Table admin.billing_subscription_transitions {
  from_status admin.subscription_status [not null]
  to_status admin.subscription_status [not null]
  indexes {
    (from_status, to_status) [pk]
  }
  Note: 'Transiciones válidas de suscripción. El trigger rechaza cualquier otra.'
}

Table admin.billing_payment_methods {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  user_id uuid [not null, note: 'ref lógica → app.users.id (pagador)']
  user_email citext [not null]
  provider varchar(24) [not null, default: 'transbank_oneclick']
  tbk_username varchar(40) [not null, note: 'username enviado a Transbank; se repite en cada cobro']
  inscription_token_hash char(64) [unique, note: 'SHA-256 del TBK_TOKEN']
  inscription_expires_at timestamptz
  tbk_user_enc bytea [note: 'tbk_user cifrado en aplicación (Key Vault). Nunca en claro ni en el historial']
  card_type varchar(20)
  card_last4 char(4)
  authorization_code varchar(6)
  status admin.payment_method_status [not null, default: 'pending']
  failure_code varchar(40)
  activated_at timestamptz
  removed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, user_id) [unique, note: 'WHERE status = active: una tarjeta activa por usuario']
    (tenant_id, user_id, created_at)
  }
  Note: 'Tarjetas inscritas en Oneclick Mall. Solo tipo y últimos 4 dígitos.'
}

Table admin.billing_subscriptions {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  user_id uuid [not null, note: 'ref lógica → app.users.id (pagador)']
  user_email citext [not null]
  user_name varchar(120)
  plan_code varchar(12) [not null, note: 'gold | platinum | provider (nunca free)']
  beneficiary_type varchar(12) [not null, note: '= plans.billing_unit: user | family | provider']
  beneficiary_id uuid [not null, note: 'ref lógica → app.users / app.families / app.providers']
  status admin.subscription_status [not null, default: 'incomplete']
  payment_method_id uuid
  price_amount integer [not null, note: 'Precio mensual congelado al suscribirse']
  currency_code char(3) [not null, default: 'CLP']
  billing_anchor_day smallint [note: 'Día del mes del primer pago']
  current_period_start timestamptz
  current_period_end timestamptz
  next_charge_at timestamptz [note: 'Fin de periodo o fecha del próximo reintento']
  retry_count smallint [not null, default: 0]
  cancel_at_period_end boolean [not null, default: false]
  pending_plan_code varchar(12) [note: 'Cambio de plan programado para la renovación']
  pending_beneficiary_type varchar(12)
  pending_beneficiary_id uuid
  canceled_at timestamptz
  cancel_reason varchar(20) [note: 'user_request | payment_failed | admin | fraud | plan_change']
  cancel_note varchar(500)
  started_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    (tenant_id, beneficiary_type, beneficiary_id) [unique, note: 'WHERE status IN (incomplete, active, past_due)']
    next_charge_at [note: 'WHERE status IN (active, past_due)']
    (tenant_id, status, created_at)
    (tenant_id, plan_code, status)
  }
  Note: 'Suscripciones mensuales. Fuente de MRR y de la mezcla de planes.'
}

Table admin.billing_charges {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  subscription_id uuid [not null]
  payment_method_id uuid [not null]
  user_id uuid [not null]
  plan_code varchar(12) [not null]
  kind admin.charge_kind [not null]
  attempt smallint [not null, default: 1]
  buy_order varchar(26) [unique, not null, note: 'Orden de compra del mall (AG + aammdd + 10 hex)']
  detail_buy_order varchar(26) [unique, not null]
  commerce_code varchar(12) [not null, note: 'Tienda hija de Oneclick Mall']
  amount integer [not null]
  currency_code char(3) [not null, default: 'CLP']
  status admin.charge_status [not null, default: 'pending']
  refunded_amount integer [not null, default: 0]
  period_start timestamptz [not null]
  period_end timestamptz [not null]
  response_code smallint
  authorization_code varchar(6)
  payment_type_code varchar(3)
  installments_number smallint
  card_last4 char(4)
  transaction_date timestamptz
  accounting_date char(4)
  failure_code varchar(40)
  failure_message varchar(300)
  gateway_response jsonb [note: 'Respuesta saneada de Transbank (evidencia ante contracargos)']
  requested_by uuid [note: 'Admin que lanzó un reintento manual']
  resolved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  indexes {
    subscription_id [unique, note: 'WHERE status IN (pending, unknown): un cobro en vuelo por suscripción']
    (subscription_id, created_at)
    (tenant_id, status, created_at)
  }
  Note: 'Cada intento de cobro. Se inserta en pending antes de llamar a Transbank; unknown se concilia con GET status.'
}

Table admin.billing_refunds {
  id uuid [pk, default: `gen_random_uuid()`]
  tenant_id uuid [not null]
  charge_id uuid [not null]
  amount integer [not null]
  status varchar(10) [not null, note: 'succeeded | failed']
  refund_type varchar(10) [note: 'REVERSED | NULLIFIED']
  authorization_code varchar(6)
  response_code smallint
  reason varchar(500) [not null]
  failure_message varchar(300)
  gateway_response jsonb
  requested_by uuid [not null]
  requested_by_name varchar(120)
  created_at timestamptz [not null, default: `now()`]
  Note: 'Reembolsos desde la consola (solo admin). Inmutable; el trigger impide superar lo cobrado.'
}

Table admin.billing_events {
  id bigint [pk, increment]
  tenant_id uuid [not null]
  subscription_id uuid
  charge_id uuid
  user_id uuid
  type varchar(40) [not null, note: 'subscription.activated, charge.failed, payment_method.removed…']
  actor_type varchar(10) [not null, note: 'user | admin | system']
  actor_id uuid
  payload jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  Note: 'Bitácora inmutable del ciclo de vida; la API de la app la consume para notificar.'
}

Ref: admin.billing_payment_methods.tenant_id > admin.tenants.id
Ref: admin.billing_subscriptions.tenant_id > admin.tenants.id
Ref: admin.billing_charges.tenant_id > admin.tenants.id
Ref: admin.billing_refunds.tenant_id > admin.tenants.id
Ref: admin.billing_events.tenant_id > admin.tenants.id
Ref: admin.billing_subscriptions.plan_code > admin.plans.code
Ref: admin.billing_subscriptions.payment_method_id > admin.billing_payment_methods.id
Ref: admin.billing_charges.subscription_id > admin.billing_subscriptions.id
Ref: admin.billing_charges.payment_method_id > admin.billing_payment_methods.id
Ref: admin.billing_charges.plan_code > admin.plans.code
Ref: admin.billing_charges.requested_by > admin.admin_users.id
Ref: admin.billing_refunds.charge_id > admin.billing_charges.id
Ref: admin.billing_refunds.requested_by > admin.admin_users.id
Ref: admin.billing_events.subscription_id > admin.billing_subscriptions.id
Ref: admin.billing_events.charge_id > admin.billing_charges.id

TableGroup "10 Pagos y suscripciones" {
  admin.billing_subscription_transitions
  admin.billing_payment_methods
  admin.billing_subscriptions
  admin.billing_charges
  admin.billing_refunds
  admin.billing_events
}
