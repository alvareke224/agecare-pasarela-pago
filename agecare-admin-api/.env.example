# Copia a .env y ajusta
ADMIN_DATABASE_URL=postgresql+asyncpg://agecare:agecare@localhost:5432/agecare_admin
ADMIN_JWT_SECRET=cambia-esto-en-produccion
ADMIN_ENVIRONMENT=dev
ADMIN_ALLOWED_EMAIL_DOMAINS=wellq.co.uk,wellq.co
ADMIN_CORS_ORIGINS=http://localhost:5173

# ---- Pasarela de pago (Transbank Oneclick Mall) ----
# fake = simulador local de Webpay · transbank = Transbank real
ADMIN_BILLING_GATEWAY=fake
# Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ADMIN_BILLING_ENCRYPTION_KEY=
ADMIN_PUBLIC_BASE_URL=http://localhost:8000
ADMIN_BILLING_RETURN_URL=http://localhost:5173/checkout/resultado
# Integración (valores públicos de Transbank). En producción: los del contrato, desde Key Vault.
ADMIN_TBK_ENVIRONMENT=integration
ADMIN_TBK_COMMERCE_CODE=597055555541
ADMIN_TBK_CHILD_COMMERCE_CODE=597055555542
ADMIN_TBK_API_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# JWT de usuarios de la app (lo emite la API principal de AgeCare)
ADMIN_APP_JWT_SECRET=cambia-esto-jwt-app
ADMIN_APP_JWT_ALGORITHM=HS256

# ---- Despliegue (Vercel) ----
# Orígenes extra permitidos por CORS (URLs de previsualización de Vercel)
ADMIN_CORS_ORIGIN_REGEX=
# Secreto del cron diario de Vercel (sin prefijo ADMIN_)
CRON_SECRET=
# En Vercel la BD puede venir como DATABASE_URL o POSTGRES_URL (Neon); se normaliza sola
