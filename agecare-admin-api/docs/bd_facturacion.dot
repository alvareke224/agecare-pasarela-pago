e</td><td align="left" port="failure_message_r"><font color="#5b6b82">varchar(300)?</font></td></tr><tr><td align="left" port="gateway_response">gateway_response</td><td align="left" port="gateway_response_r"><font color="#5b6b82">jsonb?</font></td></tr><tr><td align="left" port="requested_by"><font color="#b35c00">FK</font> requested_by</td><td align="left" port="requested_by_r"><font color="#5b6b82">uuid?</font></td></tr><tr><td align="left" port="resolved_at">resolved_at</td><td align="left" port="resolved_at_r"><font color="#5b6b82">timestamptz?</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left" port="created_at_r"><font color="#5b6b82">timestamptz</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left" port="updated_at_r"><font color="#5b6b82">timestamptz</font></td></tr></table>>];
