nt></td></tr><tr><td align="left" port="started_at">started_at</td><td align="left" port="started_at_r"><font color="#5b6b82">timestamptz?</font></td></tr><tr><td align="left" port="created_at">created_at</td><td align="left" port="created_at_r"><font color="#5b6b82">timestamptz</font></td></tr><tr><td align="left" port="updated_at">updated_at</td><td align="left" port="updated_at_r"><font color="#5b6b82">timestamptz</font></td></tr></table>>];
